{
  "default-configuration": "Debug",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/firebase/firebase-ios-sdk",
      "version": {
        "up-to-next-major-version": "12.0.0",
      },
    },
  ],
  "files": [
    {
      "kind": "group",
      "path": "IdiomBridge",
      "children": [
        { "path": "AppIcon.icon", "target-membership": [ "IdiomBridge/resources" ] },
        { "path": "Assets.xcassets", "target-membership": [ "IdiomBridge/resources" ] },
        { "path": "GoogleService-Info.plist", "target-membership": [ "IdiomBridge/resources" ] },
        { "path": "IdiomBridgeApp.swift", "target-membership": [ "IdiomBridge/compile-sources" ] },
        {
          "kind": "group",
          "path": "Models",
          "children": [
            { "path": "IdiomBridgeModels.swift", "target-membership": [ "IdiomBridge/compile-sources" ] },
          ],
        }, {
          "kind": "group",
          "path": "Services",
          "children": [
            { "path": "IdiomTranslationService.swift", "target-membership": [ "IdiomBridge/compile-sources" ] },
          ],
        }, {
          "kind": "group",
          "path": "Theme",
          "children": [
            { "path": "IdiomBridgeTheme.swift", "target-membership": [ "IdiomBridge/compile-sources" ] },
          ],
        }, {
          "kind": "group",
          "path": "ViewModels",
          "children": [
            { "path": "IdiomBridgeViewModel.swift", "target-membership": [ "IdiomBridge/compile-sources" ] },
          ],
        }, {
          "kind": "group",
          "path": "Views",
          "children": [
            { "path": "ContentView.swift", "target-membership": [ "IdiomBridge/compile-sources" ] },
            {
              "kind": "group",
              "path": "Components",
              "children": [
                { "path": "InputIdiomCard.swift", "target-membership": [ "IdiomBridge/compile-sources" ] },
                { "path": "LanguageBadge.swift", "target-membership": [ "IdiomBridge/compile-sources" ] },
                { "path": "LanguagePairBar.swift", "target-membership": [ "IdiomBridge/compile-sources" ] },
                { "path": "OutputIdiomCard.swift", "target-membership": [ "IdiomBridge/compile-sources" ] },
              ],
            },
          ],
        },
      ],
    }, {
      "kind": "group",
      "path": "IdiomBridgeTests",
      "children": [
        { "path": "IdiomBridgeTests.swift", "target-membership": [ "IdiomBridgeTests/compile-sources" ] },
      ],
    }, {
      "kind": "group",
      "path": "IdiomBridgeUITests",
      "children": [
        { "path": "IdiomBridgeUITests.swift", "target-membership": [ "IdiomBridgeUITests/compile-sources" ] },
        { "path": "IdiomBridgeUITestsLaunchTests.swift", "target-membership": [ "IdiomBridgeUITests/compile-sources" ] },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/IdiomBridge.app", "id": "65AD2D43CD2F43E36163DAAF", "index": false },
        { "path": "<PRODUCTS>/IdiomBridgeTests.xctest", "id": "0E0FFA4B8AADFF8BEE6B1470", "index": false },
        { "path": "<PRODUCTS>/IdiomBridgeUITests.xctest", "id": "24F8DB83C6EA1AA83E810223", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "IdiomBridge",
      "id": "5E6AC6BA4888DAB54B53E77A",
      "product": "Products/IdiomBridge.app",
      "product-type": "application",
      "legacy-provisioning-style": "manual",
      "build-phases": [
        "compile-sources",
        "resources",
        "frameworks",
      ],
      "package-product-members": [
        {
          "package": "firebase-ios-sdk",
          "product-name": "FirebaseAI",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "firebase-ios-sdk",
          "product-name": "FirebaseAppCheck",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "firebase-ios-sdk",
          "product-name": "FirebaseCore",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_IDENTITY": "-",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_USER_SELECTED_FILES": "readonly",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UIStatusBarStyle[sdk=iphoneos*]": "UIStatusBarStyleDefault",
        "INFOPLIST_KEY_UIStatusBarStyle[sdk=iphonesimulator*]": "UIStatusBarStyleDefault",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.google.firebase.example.agenticway",
        "REGISTER_APP_GROUPS": "YES",
        "SDKROOT": "auto",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "YES",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "IdiomBridgeTests",
      "id": "FC8D4DDC468E3F41A984ECD0",
      "product": "Products/IdiomBridgeTests.xctest",
      "product-type": "bundle.unit-test",
      "legacy-provisioning-style": "manual",
      "dependencies": [
        "IdiomBridge",
      ],
      "build-phases": [
        "compile-sources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CODE_SIGN_IDENTITY": "-",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@loader_path/Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.google.firebase.example.agenticwayTests",
        "SDKROOT": "auto",
        "STRING_CATALOG_GENERATE_SYMBOLS": "NO",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "YES",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "YES",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/IdiomBridge.app/IdiomBridge",
      },
    }, {
      "name": "IdiomBridgeUITests",
      "id": "9BE055E06BEE25EF27DB2F1B",
      "product": "Products/IdiomBridgeUITests.xctest",
      "product-type": "bundle.ui-testing",
      "legacy-provisioning-style": "manual",
      "test-host-target": "IdiomBridge",
      "dependencies": [
        "IdiomBridge",
      ],
      "build-phases": [
        "compile-sources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CODE_SIGN_IDENTITY": "-",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@loader_path/Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.google.firebase.example.agenticwayUITests",
        "SDKROOT": "auto",
        "STRING_CATALOG_GENERATE_SYMBOLS": "NO",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "YES",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "YES",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "TEST_TARGET_NAME": "IdiomBridge",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "CLANG_ANALYZER_NONNULL": "YES",
    "CLANG_ANALYZER_NUMBER_OBJECT_CONVERSION": "YES_AGGRESSIVE",
    "CLANG_CXX_LANGUAGE_STANDARD": "gnu++14",
    "CLANG_CXX_LIBRARY": "libc++",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "CLANG_ENABLE_OBJC_WEAK": "YES",
    "CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING": "YES",
    "CLANG_WARN_BOOL_CONVERSION": "YES",
    "CLANG_WARN_COMMA": "YES",
    "CLANG_WARN_CONSTANT_CONVERSION": "YES",
    "CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS": "YES",
    "CLANG_WARN_DIRECT_OBJC_ISA_USAGE": "YES_ERROR",
    "CLANG_WARN_DOCUMENTATION_COMMENTS": "YES",
    "CLANG_WARN_EMPTY_BODY": "YES",
    "CLANG_WARN_ENUM_CONVERSION": "YES",
    "CLANG_WARN_INFINITE_RECURSION": "YES",
    "CLANG_WARN_INT_CONVERSION": "YES",
    "CLANG_WARN_NON_LITERAL_NULL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF": "YES",
    "CLANG_WARN_OBJC_LITERAL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_ROOT_CLASS": "YES_ERROR",
    "CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER": "YES",
    "CLANG_WARN_RANGE_LOOP_ANALYSIS": "YES",
    "CLANG_WARN_STRICT_PROTOTYPES": "YES",
    "CLANG_WARN_SUSPICIOUS_MOVE": "YES",
    "CLANG_WARN_UNGUARDED_AVAILABILITY": "YES_AGGRESSIVE",
    "CLANG_WARN_UNREACHABLE_CODE": "YES",
    "CLANG_WARN__DUPLICATE_METHOD_MATCH": "YES",
    "CODE_SIGN_IDENTITY": "-",
    "CODE_SIGN_STYLE": "Manual",
    "COPY_PHASE_STRIP": "NO",
    "CURRENT_PROJECT_VERSION": "1",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "ENABLE_NS_ASSERTIONS[config=Release]": "NO",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "GCC_C_LANGUAGE_STANDARD": "gnu11",
    "GCC_DYNAMIC_NO_PIC[config=Debug]": "NO",
    "GCC_NO_COMMON_BLOCKS": "YES",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "GCC_PREPROCESSOR_DEFINITIONS[config=Debug]": [
      "$(inherited)",
      "DEBUG=1",
    ],
    "GCC_WARN_64_TO_32_BIT_CONVERSION": "YES",
    "GCC_WARN_ABOUT_RETURN_TYPE": "YES_ERROR",
    "GCC_WARN_UNDECLARED_SELECTOR": "YES",
    "GCC_WARN_UNINITIALIZED_AUTOS": "YES_AGGRESSIVE",
    "GCC_WARN_UNUSED_FUNCTION": "YES",
    "GCC_WARN_UNUSED_VARIABLE": "YES",
    "GENERATE_INFOPLIST_FILE": "YES",
    "IPHONEOS_DEPLOYMENT_TARGET": "27.0",
    "MARKETING_VERSION": "1.0",
    "MTL_ENABLE_DEBUG_INFO[config=Debug]": "INCLUDE_SOURCE",
    "MTL_ENABLE_DEBUG_INFO[config=Release]": "NO",
    "MTL_FAST_MATH": "YES",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "PRODUCT_NAME": "$(TARGET_NAME)",
    "SDKROOT": "auto",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG",
    "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
    "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
    "SWIFT_STRICT_CONCURRENCY": "complete",
    "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
    "SWIFT_VERSION": "6.0",
  },
  "last-upgrade": "14.3",
}
