rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: users/{userId}/idioms
// Document ID: {idiomId} (auto-generated or client-assigned document ID)
// Fields:
//   - sourceText: string (required, 1..500 chars, non-empty after trim) - Original idiom text
//   - translatedText: string (required, 1..500 chars, non-empty after trim) - Translated idiom text
//   - sourceLanguage: string (required, one of 'britishEnglish', 'brazilianPortuguese', 'german', 'chileanSpanish')
//   - targetLanguage: string (required, one of 'britishEnglish', 'brazilianPortuguese', 'german', 'chileanSpanish', must differ from sourceLanguage)
//   - createdAt: timestamp (required, immutable) - Creation timestamp
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated.
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user owns the path under users/{userId}.
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validate that the document contains only the allowed fields.
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate that all required fields exist on the document.
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate a non-empty string field within inclusive length bounds.
    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].trim().size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    // Validate that a language identifier is one of the supported Idiom Bridge locales.
    function isSupportedLanguage(language) {
      return language is string &&
        language in [
          'britishEnglish',
          'brazilianPortuguese',
          'german',
          'chileanSpanish'
        ];
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidSavedIdiom(data) {
      let requiredFields = [
        'sourceText',
        'translatedText',
        'sourceLanguage',
        'targetLanguage',
        'createdAt'
      ];
      return hasOnlyAllowedFields(requiredFields) &&
        hasRequiredFields(requiredFields) &&
        validStringLength('sourceText', 1, 500) &&
        validStringLength('translatedText', 1, 500) &&
        isSupportedLanguage(data.sourceLanguage) &&
        isSupportedLanguage(data.targetLanguage) &&
        data.sourceLanguage != data.targetLanguage &&
        data.createdAt is timestamp;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Default deny all reads and writes across the entire database.
    match /{document=**} {
      allow read, write: if false;
    }

    // User-scoped saved idioms collection.
    match /users/{userId}/idioms/{idiomId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidSavedIdiom(request.resource.data);
      allow update: if false;
      allow delete: if isOwner(userId);
    }
  }
}
